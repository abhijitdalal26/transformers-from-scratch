# Python cache
__pycache__/
*.pyc

# Scratch output dirs (never commit)
out/
out-smoke-test/

# Virtual environments
venv/
.env/

# Jupyter checkpoints
.ipynb_checkpoints/

# VS Code
.vscode/

# OS files
.DS_Store
Thumbs.db

# Obsidian note-taking app state (UI layout, plugin config)
.obsidian/

# Large data files
data/
*.csv
*.tsv
*.h5
# ...but the measured training curves are results, so they stay tracked.
!pytorch-transformer/results/**/*.csv

# Node
node_modules/

# Transformer checkpoints & tokenizers
# model/ holds the 838 MB tmodel_17.pt checkpoint and the tokenizer JSONs.
opus_books_weights/
weights/
*_weights/
tokenizer_*.json
runs/
*_runs/
*_runs-*_*/
*_runs-*/
# Colab Drive mirror. The discarded checkpoints are dropped by the *.pt rule
# and the TensorBoard run dir by *_runs/, so drive/ is fully ignored — the
# event files are reproducible from a rerun on Colab.
*.pt
!venv/**/*.pt

# Local-only working dirs for the transformer project.
# The tracked record of what was measured lives in pytorch-transformer/results/;
# these four are the live working copies: the checkpoint folder, the analysis
# scripts, the generated graphs, and the Colab Drive mirror of the BPE run.
pytorch-transformer/model/
pytorch-transformer/tools/
pytorch-transformer/graphs/
pytorch-transformer/drive_bpe/

# Mini project report (docx/pdf + figure screenshots) - local only
doc/

